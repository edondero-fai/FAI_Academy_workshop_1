# This files is used to store environmental variables,
#use it to store secrets and parameters to avoid searching
#the full codebase to change them.
# Copy this file to .env and replace only the placeholder key.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5-mini
PROMPT_VERSION=municipal-assistant-v1
DIAGNOSTICS_PATH=diagnostics/model_calls.jsonl
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT=municipal-front-desk
